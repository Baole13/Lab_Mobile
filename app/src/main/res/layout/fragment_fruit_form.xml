<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/text_hero" android:textStyle="bold" style="@style/Widget.FruitShop.Title" />
        <ProgressBar android:id="@+id/progressLoading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/name" android:text="Tên trái cây" android:layout_marginTop="12dp" style="@style/Widget.FruitShop.Label" />
        <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:saveEnabled="true" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/category" android:text="Loại trái cây" android:layout_marginTop="12dp" style="@style/Widget.FruitShop.Label" />
        <EditText android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:saveEnabled="true" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/price" android:text="Giá (đồng), ví dụ 45000 hoặc 45000.5" android:layout_marginTop="12dp" style="@style/Widget.FruitShop.Label" />
        <EditText android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="numberDecimal" android:saveEnabled="true" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/quantity" android:text="Số lượng" android:layout_marginTop="12dp" style="@style/Widget.FruitShop.Label" />
        <EditText android:id="@+id/quantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:saveEnabled="true" android:singleLine="true" android:textColor="@color/text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/expiryDate" android:text="Hạn sử dụng (yyyy-MM-dd)" android:layout_marginTop="12dp" style="@style/Widget.FruitShop.Label" />
        <EditText android:id="@+id/expiryDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="date" android:saveEnabled="true" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@+id/description" android:text="Mô tả" android:layout_marginTop="12dp" style="@style/Widget.FruitShop.Label" />
        <EditText android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textMultiLine" android:saveEnabled="true" android:minLines="3" android:gravity="top" android:singleLine="false" />
        <TextView android:id="@+id/tvError" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textColor="@color/status_discount_text" />
        <Button android:id="@+id/btnRetry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tải lại" android:visibility="gone" style="@style/Widget.FruitShop.Button" android:textAllCaps="false" android:minHeight="48dp" />
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lưu" style="@style/Widget.FruitShop.Button" android:textAllCaps="false" android:minHeight="48dp" />
        <Button android:id="@+id/btnCancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quay lại" style="@style/Widget.FruitShop.Button.Secondary" android:textAllCaps="false" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
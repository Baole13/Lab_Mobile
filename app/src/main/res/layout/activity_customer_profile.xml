<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_xl" android:paddingTop="@dimen/space_3xl">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Hồ sơ khách hàng" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" style="@style/Widget.FruitShop.Title" />
        <TextView android:id="@+id/tvAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:text="Tài khoản: customer · Customer" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Họ và tên" android:textStyle="bold" />
        <TextView android:id="@+id/tvFullname" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="—" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Số điện thoại" android:textStyle="bold" />
        <TextView android:id="@+id/tvPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="—" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email" android:textStyle="bold" />
        <TextView android:id="@+id/tvEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="—" android:textSize="18sp" />
        <TextView android:id="@+id/tvProfileStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/status_discount_text" android:textSize="14sp" />
        <Button android:id="@+id/btnEditProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Sửa thông tin" style="@style/Widget.FruitShop.Button" android:textAllCaps="false" android:minHeight="48dp" />
        <Button android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Quay lại trang chủ" style="@style/Widget.FruitShop.Button.Secondary" android:textAllCaps="false" android:minHeight="48dp" />
        <Button android:id="@+id/btnProfileLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Đăng xuất" style="@style/Widget.FruitShop.Button.Danger" android:textAllCaps="false" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_xl">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chỉnh sửa" android:textSize="@dimen/text_hero" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginBottom="12dp" style="@style/Widget.FruitShop.Title" />
        <LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Lưu" style="@style/Widget.FruitShop.Button" android:textAllCaps="false" android:minHeight="48dp" />
        <Button android:id="@+id/delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xóa bản ghi" style="@style/Widget.FruitShop.Button.Danger" android:textAllCaps="false" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
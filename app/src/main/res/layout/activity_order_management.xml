<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <!-- Top Header + Search Bar + Horizontal Status Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdminOrderBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_search_bar"
                android:text="←"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Quản Lý Đơn Hàng (Admin)"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_h1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdminOrderSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Pending → Confirmed → Completed"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search Bar (Rule 3.C: h-12 = 48dp, rounded-2xl, bg-slate-100) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_bar_height"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🔍"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etSearchOrder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Tìm mã đơn (#1), tên khách hàng, ngày đặt..."
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- Horizontal Filter Chips (Rule 2.3 & 3.B: gap 10dp) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAdminFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/chip_gap"
                    android:background="@drawable/bg_chip_active"
                    android:paddingHorizontal="16dp"
                    android:text="Tất cả"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_700"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAdminFilterPending"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/chip_gap"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="16dp"
                    android:text="⏳ Pending"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <Button
                    android:id="@+id/btnAdminFilterConfirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/chip_gap"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="16dp"
                    android:text="🚚 Confirmed"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <Button
                    android:id="@+id/btnAdminFilterCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="16dp"
                    android:text="✅ Completed"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Admin Orders Card List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_2xl">

        <LinearLayout
            android:id="@+id/adminOrdersCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>

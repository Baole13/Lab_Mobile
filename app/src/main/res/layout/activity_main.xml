<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_2xl">

        <!-- Role Badge -->
        <TextView
            android:id="@+id/tvRoleSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_active"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="ROLE BADGE"
            android:textColor="@color/primary_700"
            android:textSize="@dimen/text_badge"
            android:textStyle="bold" />

        <!-- Hero Greeting (26sp bold #0F172A) -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Fruit Shop"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_hero"
            android:textStyle="bold" />

        <!-- Stats Summary Card (#FFFFFF rounded-2xl border #E2E8F0) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TỔNG QUAN HỆ THỐNG"
                android:textColor="@color/primary_600"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDashboardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:text="Đang tải dữ liệu..."
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:text="Chức năng chính"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_h2"
            android:textStyle="bold" />

        <!-- Dynamic Role Menu Cards -->
        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Logout Button (Touch target >= 48dp) -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_bar_height"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_badge_error"
            android:text="Đăng xuất tài khoản"
            android:textAllCaps="false"
            android:textColor="@color/status_discount_text"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

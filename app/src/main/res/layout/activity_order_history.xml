<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <!-- Top Header & Horizontal Status Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHistoryBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_search_bar"
                android:text="←"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Lịch Sử Đơn Hàng"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_h1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHistorySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Đơn hàng của bạn"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <Button
                android:id="@+id/btnHistoryNewOrder"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="14dp"
                android:text="+ Đặt đơn"
                android:textAllCaps="false"
                android:textColor="@color/text_inverse"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Horizontal Filter Chips (Rule 2.3 & 3.B: gap 10dp) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHistoryFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/chip_gap"
                    android:background="@drawable/bg_chip_active"
                    android:paddingHorizontal="16dp"
                    android:text="Tất cả"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_700"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHistoryFilterPending"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/chip_gap"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="16dp"
                    android:text="⏳ Pending"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <Button
                    android:id="@+id/btnHistoryFilterConfirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/chip_gap"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="16dp"
                    android:text="🚚 Confirmed"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <Button
                    android:id="@+id/btnHistoryFilterCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="16dp"
                    android:text="✅ Completed"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Order History Cards List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_2xl">

        <LinearLayout
            android:id="@+id/orderHistoryCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>

<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@color/surface_background">
    <Button android:id="@+id/btnBack" android:text="←  Quay lại" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.FruitShop.Button.Secondary" android:textAllCaps="false" android:minHeight="48dp" />
    <ProgressBar android:id="@+id/progressLoading" android:visibility="gone" android:layout_gravity="center_horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" />
    <TextView android:id="@+id/tvNotFound" android:visibility="gone" android:text="Không tìm thấy trái cây này. Có thể bản ghi đã bị xóa." android:gravity="center" android:textColor="@color/fruit_text_primary" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" />
    <LinearLayout android:id="@+id/errorGroup" android:visibility="gone" android:gravity="center" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
        <TextView android:text="Không thể tải thông tin trái cây." android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/btnRetry" android:text="Thử lại" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.FruitShop.Button" android:textAllCaps="false" android:minHeight="48dp" />
    </LinearLayout>
    <ScrollView android:id="@+id/detailContent" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:paddingTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/tvName" android:textSize="@dimen/text_hero" android:textStyle="bold" android:textColor="@color/fruit_text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvCategory" android:textSize="16sp" android:textColor="@color/fruit_text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tvPrice" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/fruit_primary_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" />
            <TextView android:id="@+id/tvQuantity" android:textSize="16sp" android:textColor="@color/fruit_text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/tvExpiryDate" android:textSize="16sp" android:textColor="@color/fruit_text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/tvExpiryStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="12dp" />
            <LinearLayout android:id="@+id/descriptionGroup" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
                <TextView android:text="Mô tả" android:textStyle="bold" android:textColor="@color/fruit_text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDescription" android:textColor="@color/fruit_text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/btnEdit" android:text="Sửa thông tin" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FruitShop.Button" android:textAllCaps="false" android:minHeight="48dp" />
    <Button android:id="@+id/btnDelete" android:text="Xóa trái cây" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.FruitShop.Button.Danger" android:textAllCaps="false" android:minHeight="48dp" />
</LinearLayout>